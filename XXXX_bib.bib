@article{Martinson.etal2000,
  title = {Effectiveness of {{Monetary Incentives}} for {{Recruiting Adolescents}} to an {{Intervention Trial}} to {{Reduce Smoking}}},
  author = {Martinson, Brian C. and Lazovich, DeAnn and Lando, Harry A. and Perry, Cheryl L. and McGovern, Paul G. and Boyle, Raymond G.},
  date = {2000-12-01},
  journaltitle = {Preventive Medicine},
  shortjournal = {Preventive Medicine},
  volume = {31},
  number = {6},
