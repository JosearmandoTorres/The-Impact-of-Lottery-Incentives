@article{Lorenzi.etal1988,
  title = {Consumer {{Mail Survey Responses}}: {{More}} ({{Unbiased}}) {{Bang For The Buck}}},
  shorttitle = {Consumer {{Mail Survey Responses}}},
  author = {Lorenzi, Peter and Friedmann, Roberto and Paolillo, Joseph G. P.},
  date = {1988-23},
  journaltitle = {The Journal of Consumer Marketing},
  volume = {5},
  number = {4},
  pages = {31},
  publisher = {Emerald Group Publishing Limited},
  location = {Santa Barbara, United Kingdom},
  issn = {07363761},
  url = {https://www.proquest.com/docview/220132203/abstract/24D7E52489D94A7APQ/1},
  urldate = {2025-12-16},
  abstract = {Surveys were sent to 400 professionals in order to measure their propensities for financial risk and to obtain self-descriptions of personal and business financial risk-taking behavior. By modifying the type, amount, and risk of the incentive offered to each subject, 4 experimental treatments were created. There were 100 mailings per condition. The 4 conditions were: 1. prepaid, 2. promised, 3. lottery, and 4. a control group. A total of 175 responses were obtained -- 65 for the prepaid group, 33 for the promised group, 41 for the lottery group, and 36 for the control group. On the basis of statistical comparisons, the no-risk group response rate was substantially higher than each of the other incentive condition groups. No other significant variations among other conditions were found. A small, prepaid monetary incentive was much more effective in inducing a response than the risky monetary payoffs or no payoff incentive conditions. It does not appear that the kind of incentive results in a meaningful bias in the response pool.},
  langid = {english},
  pagetotal = {10},
  keywords = {Applications,Consumer,Consumer behavior,Financial risk,Incentive,Incentives,Lottery,Market research,Polls & surveys,Preference,Prepaid services,Prepayment,Questionnaires,Statistical analysis},
  file = {/Users/jtorres0/Zotero/storage/NHZ2VPX7/Lorenzi et al. - 1988 - Consumer Mail Survey Responses More (Unbiased) Bang For Th.pdf}
}

@article{Marrett.etal1992,
  title = {The Effect on Response Rates of Offering a Small Incentive with a Mailed Questionnaire},
  author = {Marrett, Loraine D. and Kreiger, Nancy and Dodds, Linda and Hilditch, Shelly},
  date = {1992-09-01},
  journaltitle = {Annals of Epidemiology},
  shortjournal = {Annals of Epidemiology},
  volume = {2},
  number = {5},
  pages = {745--753},
  issn = {1047-2797},
  doi = {10.1016/1047-2797(92)90019-M},
  url = {https://www.sciencedirect.com/science/article/pii/104727979290019M},
  urldate = {2025-12-08},
  abstract = {To determine whether response rates to a mailed questionnaire sent to population control subjects could be increased through offer of a small incentive, half of the control subjects (n = 477) in a case-control study of renal cell carcinoma were randomly selected to receive a contact letter offering a lottery ticket if a completed questionnaire was returned; the remaining subjects (n = 477) received the same letter but with no mention of a lottery ticket. Overall response rates did not differ between the two groups (72.6\% versus 74.4\%), although a higher percentage of those offered a lottery ticket responded without follow-up (24.4\% versus 18.5\%). Binomial regression modeling of the effect of the lottery ticket offer, sex, age, and percent of urban dwellers on response indicated a significant effect only for percent of urban dwellers, the rate of response increasing with a decreasing percentage of urban dwellers. The effect of sex was of borderline significance (P = 0.05), with females having the higher rate of response.},
  keywords = {incentive,response rates,Survey methods},
  file = {/Users/jtorres0/Zotero/storage/8RUCZQS8/Marrett et al. - 1992 - The effect on response rates of offering a small incentive with a mailed questionnaire.pdf;/Users/jtorres0/Zotero/storage/NGLX62EC/Marrett et al. - 1992 - The effect on response rates of offering a small incentive with a mailed questionnaire.pdf;/Users/jtorres0/Zotero/storage/VDIK4CBN/1-s2.0-104727979290019M-main.pdf;/Users/jtorres0/Zotero/storage/QQYUHQ2C/104727979290019M.html}
