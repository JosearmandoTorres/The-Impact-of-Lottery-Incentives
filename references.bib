  shorttitle = {Effects of Various Methodologic Strategies},
  author = {Grava-Gubins, Inese and Scott, Sarah},
  date = {2008-10},
  journaltitle = {Canadian Family Physician},
  shortjournal = {Can Fam Physician},
  volume = {54},
