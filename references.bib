@article{Guo.etal2016,
  title = {Population {{Survey Features}} and {{Response Rates}}: {{A Randomized Experiment}}},
  shorttitle = {Population {{Survey Features}} and {{Response Rates}}},
  author = {Guo, Yimeng and Kopec, Jacek A. and Cibere, Jolanda and Li, Linda C. and Goldsmith, Charles H.},
  date = {2016-08},
  journaltitle = {American Journal of Public Health},
  shortjournal = {Am J Public Health},
  volume = {106},
  number = {8},
