}

@article{Larson.Chow2003,
  title = {Total Cost/Response Rate Trade-Offs in Mail Survey Research: Impact of Follow-up Mailings and Monetary Incentives},
  author = {Larson, Paul D. and Chow, Garland},
  date = {2003-10-01},
  journaltitle = {Industrial Marketing Management},
  shortjournal = {Industrial Marketing Management},
  volume = {32},
